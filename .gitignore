# --- Virtual envs & secrets ---
.venv/
venv/
env/
.env
.env.*

# --- Python caches/build ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
.build/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- Notebooks ---
**/.ipynb_checkpoints/

# --- Data (large, generated) ---
data/raw_data/
data/processed_data/
data/external/
dataset/**
output/**           # singular
outputs/**          # plural, just in case
models/
logs/

# --- Generated metadata we DO NOT want ---
data/metadata/scalers/**
data/metadata/variants/**

# --- Metadata we DO want (inputs, small JSON) ---
!data/metadata/
!data/metadata/backtest/**
!data/metadata/series_maps/**
!data/metadata/variable_group_map_*.json
!data/metadata/README.md

# --- Quality checks: keep only explicit small files ---
data/quality_checks/**
!data/quality_checks/README.md
!data/quality_checks/missing_positions_summary.csv

# --- Scripts-local data ---
scripts/data/

# --- IDE ---
.idea/

# --- Helper dumps (local only) ---
OVERVIEW.txt
SRC.txt
STRUCTURE.txt
TREE.md
README.new
build_trace.html
profile.html
dep-tree.json
